library(tidyverse)
library(lmerTest)
library(gridExtra)
library(extrafont)
font_import()
library(Rmisc)
### import data
child <- read.csv("PT+SNQ Child Data_1.15.19.csv", fileEncoding = "latin1")
# exclude outlier
child_EX <- subset(child, NetworkSize < 22)
# lmer data
lmerdata <- read.csv("PT+SNQ Child Data_1.15.19_scoreperline.csv", fileEncoding = "latin1")
lmerdata <- subset(lmerdata, NetworkSize < 22)
levels(lmerdata$Exp.Imp)
levels(lmerdata$TrialType)
# subset lmerdata
lmerdata <- subset(lmerdata, TrialType == "CanSee"|TrialType =="CannotSee")
lmerdata_explicit <- subset(lmerdata, Exp.Imp == "Explicit")
lmerdata_implicit <- subset(lmerdata, Exp.Imp == "ImplicitDuration")
# Re-order levels of TrialType for Explicit
lmerdata_explicit$TrialType <- factor(lmerdata_explicit$TrialType, levels = rev(levels(lmerdata_explicit$TrialType)))
levels(lmerdata_explicit$TrialType)
# Re-order levels of TrialType for Implicit
lmerdata_implicit$TrialType <- factor(lmerdata_implicit$TrialType, levels = rev(levels(lmerdata_implicit$TrialType)))
levels(lmerdata_implicit$TrialType)
colnames(child_EX)
# networksize and vocab
ggplot(child_EX, aes(NetworkSize, PPVT)) +
theme_minimal() + theme(axis.line = colour = "black")
theme_minimal() + theme(axis.line = element_line(colour = "black")
# networksize and vocab
ggplot(child_EX, aes(NetworkSize, PPVT)) +
# networksize and vocab
ggplot(child_EX, aes(NetworkSize, PPVT)) +
theme_minimal() + theme(axis.line = element_line(colour = "black"))
# networksize and vocab
ggplot(child_EX, aes(NetworkSize, PPVT)) +
geom_point() + theme_minimal() + theme(axis.line = element_line(colour = "black"))
# test correlation
cor.test(child_EX$NetworkSize_T, child_EX$PPVT,
alternative = "two.sided", method = "pearson")
# networksize and vocab
ggplot(child_EX, aes(NetworkSize, PPVT)) +
geom_point() + theme_minimal() + theme(axis.line = element_line(colour = "black"))
library(tidyverse)
