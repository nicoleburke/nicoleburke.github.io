library(tidyverse)
library(egor)
ego_ise <- read.csv("Orginial Data Files/ISEpilot_egodataframe.csv")
alters_ise <- read.csv("Orginial Data Files/ISEpilot_SocialNetworkData.csv")
## Make Network Object
networkobject_ise <- egor(alters = alters_ise,
egos = ego_ise,
ID.vars = list(
ego = "SubjectID",
alter = "Node"
))
# check to see if this worked
networkobject_ise
# import ego dataframe
ego_20m <- read.csv("Orginial Data Files/Social Network Data_INFANT_final.csv")
ego_20m  <- subset(ego_20m , NetworkSize > 0)
# import alter dataframe
alters_20m <- read.csv("Orginial Data Files/Social Network Data_INFANTrelationships_final.csv")
## Make Network Object
networkobject_20mdata <- egor(alters = alters_20m,
egos = ego_20m ,
ID.vars = list(
ego = "SubID",
alter = "Nodes"
))
# check to see if this worked
networkobject_20mdata
summary(networkobject_20mdata)
# import ego dataframe
ego_pt <- read.csv("Orginial Data Files/PT+SNQ Child Data_1.15.19.csv",
fileEncoding = "latin1")
ego_pt <- subset(ego_pt, NetworkSize > 0)
# import alter data
alters_pt <- read.csv("Orginial Data Files/PT+SNQ Relationship Data.csv")
alters_pt <- subset(alters_pt, Ptdata. == "yes"|
Ptdata. == "yes_exclude")
## Make Network Object
networkobj_pt <- egor(alters = alters_pt,
egos = ego_pt ,
ID.vars = list(
ego = "SubID",
alter = "Nodes"
))
# check to see if this worked
networkobj_pt
summary(networkobj_pt)
### check the alter dataframe
checkptsize <- alters_pt %>%
group_by(SubID) %>%
summarize(checksize = sum(Togetsize))
# write out to compare
#write.csv(checkptsize, file = "~/Documents/To work on data off server/for today/files created for data cleaning/checksizept.csv")
