aa_racepref <- read.csv("Orginial Data Files/alter-alter dataframe.csv")
# make network object
networkobj_rp <- egor(alters = alters_racepref,
egos = ego_racepref,
aaties = aa_racepref,
ID.vars = list(
ego = "egoID",
alter = "alterID",
source = ".srcid_name",
target = ".tgtid_name"))
networkobj_rp
